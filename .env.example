# Postgres connection string (Neon / Supabase / Vercel Postgres all work)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Social login (optional - buttons show an error toast if not configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# API (default is built in, so these are optional)
NEXT_PUBLIC_API_BASE_1=https://openapi.programming-hero.com/api/bazardor
